+
+let state: WorkforceState = { team: INITIAL_TEAM, saved: ['art-2'], lastInvite: null }
+let nextId = 100
+const listeners = new Set<() => void>()
+
+const setState = (patch: Partial<WorkforceState>) => {
+  state = { ...state, ...patch }
+  listeners.forEach((listener) => listener())
