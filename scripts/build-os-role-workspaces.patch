+  text: string
+  time: string
+  read?: boolean
+  attachment?: {
+    name: string
+    type: 'document' | 'image'
+    /** Object URL for files you just attached. */
+    url?: string
+  }
+}
+
+export type Conversation = {
+  id: string
+  name: string
